@@ -0,0 +1,33 @@
+/**
+ * Wave-2 live E-proof seam (docs/superpowers/evidence/2026-08-01-wave2-eproofs/).
+ *
+ * Extends lane F's `MAPLE_HARNESS=instant` switch to the third harness so the
+ * E1 matrix can run all three columns through the SAME composed wire:
+ *
+ *   unset               → slot empty; composition serves the default `vendo()`
+ *   instant             → `harness: instant()`
+ *   claude-code         → `harness: claudeCode()` on a real sandbox machine
+ *   claude-code-local   → `harness: claudeCode({ machine: "local" })`
+ *
+ * NOT COMMITTABLE AS-IS — this file is the proof rig, reverted after the run.
+ * The `claudeCode` import is static because Turbopack refuses every dynamic
+ * form ("Cannot find module as expression is too dynamic", and `turbopackIgnore`
+ * is not honored on `require`), and a static import puts
+ * `@anthropic-ai/claude-agent-sdk` in demo-bank's build graph — where it cannot
+ * resolve, because `@vendoai/apps` imports that SDK without declaring it
+ * (packages/apps/src/claude-turn.ts:37,328). Committing this would break the
+ * deployed demo's build. See the report's finding D1.
+ */
+import { claudeCode } from "@vendoai/harnesses/claude-code";
+import { instant } from "@vendoai/vendo/server";
+import type { createVendo } from "@vendoai/vendo/server";
+
+type HarnessSlot = Pick<Parameters<typeof createVendo>[0], "harness">;
+
+export function proofHarness(): HarnessSlot | Record<string, never> {
+  const named = process.env.MAPLE_HARNESS;
+  if (named === "instant") return { harness: instant() };
+  if (named === "claude-code") return { harness: claudeCode() };
+  if (named === "claude-code-local") return { harness: claudeCode({ machine: "local" }) };
+  return {};
+}
