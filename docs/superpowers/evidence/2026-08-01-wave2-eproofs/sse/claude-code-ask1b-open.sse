= (cents: number) => {\n        const dollars = cents / 100;\n        return dollars.toLocaleString(\"en-US\", { style: \"currency\", currency: \"USD\", minimumFractionDigits: 2 });\n      };\n\n      const pct = (cents: number) => {\n        if (total === 0) return \"0%\";\n        return ((cents / total) * 100).toFixed(1) + \"%\";\n      };\n\n      const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);\n\n      const rowStyle: React.CSSProperties = {\n        display: \"flex\",\n        justifyContent: \"space-between\",\n        alignItems: \"center\",\n        padding: \"10px 0\",\n        borderBottom: \"1px solid var(--vendo-color-border)\",\n      };\n\n      const labelStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n      };\n\n      const rightStyle: React.CSSProperties = {\n        display: \"flex\",\n        gap: \"12px\",\n        alignItems: \"center\",\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n      };\n\n      const amountStyle: React.CSSProperties = {\n        color: \"var(--vendo-color-text)\",\n        fontVariantNumeric: \"tabular-nums\",\n        minWidth: \"80px\",\n        textAlign: \"right\",\n      };\n\n      const pctStyle: React.CSSProperties = {\n        color: \"var(--vendo-color-muted)\",\n        fontVariantNumeric: \"tabular-nums\",\n        minWidth: \"44px\",\n        textAlign: \"right\",\n        fontSize: \"13px\",\n      };\n\n      const totalRowStyle: React.CSSProperties = {\n        display: \"flex\",\n        justifyContent: \"space-between\",\n        alignItems: \"center\",\n        padding: \"12px 0 0 0\",\n      };\n\n      const totalLabelStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n        fontWeight: 600,\n      };\n\n      const totalAmountStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n        fontVariantNumeric: \"tabular-nums\",\n        fontWeight: 600,\n      };\n\n      return (\n        <div style={{ width: \"100%\" }}>\n          {sorted.map((item) => (\n            <div key={item.category} style={rowStyle}>\n              <span style={labelStyle}>{capitalize(item.category)}</span>\n              <div style={rightStyle}>\n                <span style={amountStyle}>{fmt(item.amount)}</span>\n                <span style={pctStyle}>{pct(item.amount)}</span>\n              </div>\n            </div>\n          ))}\n          <div style={totalRowStyle}>\n            <span style={totalLabelStyle}>Total</span>\n            <span style={totalAmountStyle}>{fmt(total)}</span>\n          </div>\n        </div>\n      );\n    }"},"componentTools":{"SpendingBreakdown":[]}},"components":{"SpendingBreakdown":"export default function SpendingBreakdown({ data }: { data: { category: string; amount: number }[] }) {\n      if (!data || data.length === 0) return null;\n\n      const total = data.reduce((sum, d) => sum + d.amount, 0);\n      const sorted = [...data].sort((a, b) => b.amount - a.amount);\n\n      const fmt = (cents: number) => {\n        const dollars = cents / 100;\n        return dollars.toLocaleString(\"en-US\", { style: \"currency\", currency: \"USD\", minimumFractionDigits: 2 });\n      };\n\n      const pct = (cents: number) => {\n        if (total === 0) return \"0%\";\n        return ((cents / total) * 100).toFixed(1) + \"%\";\n      };\n\n      const capitalize = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);\n\n      const rowStyle: React.CSSProperties = {\n        display: \"flex\",\n        justifyContent: \"space-between\",\n        alignItems: \"center\",\n        padding: \"10px 0\",\n        borderBottom: \"1px solid var(--vendo-color-border)\",\n      };\n\n      const labelStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n      };\n\n      const rightStyle: React.CSSProperties = {\n        display: \"flex\",\n        gap: \"12px\",\n        alignItems: \"center\",\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n      };\n\n      const amountStyle: React.CSSProperties = {\n        color: \"var(--vendo-color-text)\",\n        fontVariantNumeric: \"tabular-nums\",\n        minWidth: \"80px\",\n        textAlign: \"right\",\n      };\n\n      const pctStyle: React.CSSProperties = {\n        color: \"var(--vendo-color-muted)\",\n        fontVariantNumeric: \"tabular-nums\",\n        minWidth: \"44px\",\n        textAlign: \"right\",\n        fontSize: \"13px\",\n      };\n\n      const totalRowStyle: React.CSSProperties = {\n        display: \"flex\",\n        justifyContent: \"space-between\",\n        alignItems: \"center\",\n        padding: \"12px 0 0 0\",\n      };\n\n      const totalLabelStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n        fontWeight: 600,\n      };\n\n      const totalAmountStyle: React.CSSProperties = {\n        fontFamily: \"var(--vendo-font-family)\",\n        fontSize: \"var(--vendo-font-size)\",\n        color: \"#1d6fcc\",\n        fontVariantNumeric: \"tabular-nums\",\n        fontWeight: 600,\n      };\n\n      return (\n        <div style={{ width: \"100%\" }}>\n          {sorted.map((item) => (\n            <div key={item.category} style={rowStyle}>\n              <span style={labelStyle}>{capitalize(item.category)}</span>\n              <div style={rightStyle}>\n                <span style={amountStyle}>{fmt(item.amount)}</span>\n                <span style={pctStyle}>{pct(item.amount)}</span>\n              </div>\n            </div>\n          ))}\n          <div style={totalRowStyle}>\n            <span style={totalLabelStyle}>Total</span>\n            <span style={totalAmountStyle}>{fmt(total)}</span>\n          </div>\n        </div>\n      );\n    }"}},"dynamic":true}

