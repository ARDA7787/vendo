data: {"type":"tool-input-available","toolCallId":"hcall_5_1c43b28c-13e0-4b5a-b98c-7542a34248ac","toolName":"vendo_apps_create","input":{"prompt":"Build a daily balance-check app for Maple banking. Every day, fetch the checking account balance using the host accounts data. If the balance falls below $2,000, display a prominent in-app notification card alerting the user that their checking balance is below $2,000, showing the actual current balance. If the balance is at or above $2,000, show a calm confirmation card with the current balance and a green status indicator. Always show the current checking balance prominently. The notification should be clear and actionable — show the balance, the threshold ($2,000), and how much below the threshold they are (if applicable). Use the MapleSparkline to show recent balance trend if available. No emojis. Plain, calm banking language."},"dynamic":true}

