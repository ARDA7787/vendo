data: {"type":"tool-output-available","toolCallId":"hcall_11_a829163e-9b1a-4f57-bf34-e73578bf5aec","output":{"loaded":["vendo_apps_open","slack_SLACK_OPEN_DM","slack_SLACK_OPEN_OR_RESUME_DIRECT_OR_MULTI_PERSON_MESSAGES","vendo_apps_rebase_pin","host_getSpendingInsights","vendo_apps_create","vendo_apps_data_delete","vendo_apps_data_list","vendo_apps_data_put","vendo_apps_edit"],"tools":[{"name":"vendo_apps_open","description":"Open the latest serving surface for a Vendo app.","risk":"read"},{"name":"slack_SLACK_OPEN_DM","description":"Opens or resumes a slack direct message (dm) or multi-person direct message (mpim) by providing either user ids or an existing channel id.","risk":"write","toolkit":"slack","connectRequired":true},{"name":"slack_SLACK_OPEN_OR_RESUME_DIRECT_OR_MULTI_PERSON_MESSAGES","description":"Deprecated: opens or resumes a slack direct message (dm) or multi-person direct message (mpim). use `open dm` instead.","risk":"write","toolkit":"slack","connectRequired":true},{"name":"vendo_apps_rebase_pin","description":"Rebase one drifted remixed pin of a Vendo app onto the host's updated component: re-fork the new captured baseline and replay the recorded edit intents in order. Use when an edit result or open() payload reports drifted pins and the user asks to update the remix. If the result has status \"failed\", nothing was changed; it lists which intents replayed and which failed.","risk":"write"},{"name":"host_getSpendingInsights","description":"Spending by category for the current period. Amounts are integer cents (e.g. 285000 = $2,850.00): divide by 100 exactly once before displaying, including any totals you compute.","risk":"read"},{"name":"vendo_apps_create","description":"Create a Vendo app from a natural-language prompt. Pass the user's request (with any clarifying context) as the prompt. Never bake data values you computed or fetched (counts, totals, amounts) into the prompt — the app binds live host data itself and hardcoded figures fail its build. Never specify fonts, colors, or branding — the app inherits the host theme.","risk":"read"},{"name":"vendo_apps_data_delete","description":"Delete a record from a declared Vendo app data collection.","risk":"write"},{"name":"vendo_apps_data_list","description":"List records from a declared Vendo app data collection.","risk":"read"},{"name":"vendo_apps_data_put","description":"Create or replace a record in a declared Vendo app data collection.","risk":"write"},{"name":"vendo_apps_edit","description":"Edit an existing Vendo app with one natural-language instruction. If the result has failure.retryable=true, retry vendo_apps_edit on the same appId with a narrower instruction; do not rebuild it with vendo_apps_create.","risk":"read"}]},"dynamic":true}

