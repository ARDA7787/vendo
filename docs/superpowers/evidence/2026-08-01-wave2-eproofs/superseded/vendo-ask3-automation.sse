data: {"type":"tool-input-available","toolCallId":"hcall_4_4f8601c0-9420-483d-9c5b-c7290ebd73e9","toolName":"vendo_apps_create","input":{"prompt":"Build a daily balance monitor for the user's checking account. Each day, fetch the checking account balance. If the balance falls below $2,000, display a prominent in-app notification alert that says the checking balance has dropped below $2,000 and shows the current balance. The app should show the current checking balance clearly at all times, along with the $2,000 threshold, the last-checked time, and the alert status (OK or Below Threshold). Use MapleSparkline to show a recent balance trend if available."},"dynamic":true}

