data: {"type":"tool-input-available","toolCallId":"hcall_7_d5babdba-08c8-483d-9a11-1cd10137b6e8","toolName":"vendo_apps_create","input":{"prompt":"Build a simple savings balance view for the Maple Savings account (acc_savings). Show:\n- The current balance prominently\n- The APY (4.25%)\n- A MapleSparkline showing the balance trend over time\n- The account mask (ending 8820)\n\nUse the host_listAccounts tool to bind live data. Pull the savings account from the accounts list. Display the balance as currency. Keep the layout clean and minimal — a single card with the account name, balance, APY badge, and the sparkline trend beneath."},"dynamic":true}

