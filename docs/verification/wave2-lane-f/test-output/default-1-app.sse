data: {"type":"tool-input-available","toolCallId":"hcall_2_16d8de89-ac0b-4318-95af-b4f05a38ee54","toolName":"vendo_apps_create","input":{"prompt":"Build a simple savings balance view for the Maple Savings account (acc_savings). Show:\n- The account name and masked number\n- The current balance prominently\n- The APY\n- A MapleSparkline showing the balance trend over time\n\nBind all data live from host_listAccounts and find the savings account (kind === \"savings\"). Use the account's sparkline array for the trend. Display balance as currency. Keep the layout clean and minimal."},"dynamic":true}

