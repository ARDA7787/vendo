data: {"type":"text-delta","id":"txt_1_4dd76265-7c43-40ea-8996-88ec54c41c48","delta":"I'll build"}

data: {"type":"text-delta","id":"txt_1_4dd76265-7c43-40ea-8996-88ec54c41c48","delta":" a weekly spending summary app and schedule it to run every Friday morning. Let me create that for you now."}

data: {"type":"text-end","id":"txt_1_4dd76265-7c43-40ea-8996-88ec54c41c48"}

data: {"type":"tool-input-start","toolCallId":"hcall_4_909bbd2f-c02a-4098-86b2-c6c1584e76fd","toolName":"vendo_apps_create","dynamic":true}

data: {"type":"tool-input-available","toolCallId":"hcall_4_909bbd2f-c02a-4098-86b2-c6c1584e76fd","toolName":"vendo_apps_create","input":{"prompt":"Build a weekly spending summary report. It should:\n- Pull spending insights and recent transactions for the current week (Monday through the current day)\n- Show a breakdown of spending by category using MapleSpendingDonut\n- List the top transactions for the week (merchant, category, amount, date)\n- Show total spent this week prominently at the top\n- Show a comparison or note if spending is higher or lower than typical\n- Keep the layout clean and readable, suitable for a Friday morning check-in\n- Use integer cents throughout (divide by 100 only when displaying as currency)\n- No emojis, plain language, currency formatted as $X,XXX.XX"},"dynamic":true}

