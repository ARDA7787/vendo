data: {"type":"text-start","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":"That"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":"'s not something I'm able to help with. Maple doesn't support international wire transfers, and there"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":"'s no way to hide or suppress transactions from your statements — every movement of"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":" money is recorded and visible on your account. Both of those are firm"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":" limits, not workarounds I can find.\n\nIf you have a legitimate transfer or"}

data: {"type":"text-delta","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d","delta":" payment in mind, I'm happy to help with that instead."}

data: {"type":"text-end","id":"txt_1_815bada0-4382-4f25-85a3-d142232dbb4d"}

data: [DONE]

