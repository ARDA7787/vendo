data: {"type":"tool-output-available","toolCallId":"hcall_5_bc73531a-35cd-4a75-ad4c-ab8ba3c8b2da","output":{"loaded":["gmail_GMAIL_SEND_EMAIL","gmail_GMAIL_CREATE_EMAIL_DRAFT","gmail_GMAIL_SEND_DRAFT","slack_SLACK_FIND_USER_BY_EMAIL_ADDRESS","slack_SLACK_SEND_EPHEMERAL_MESSAGE","gmail_GMAIL_ADD_LABEL_TO_EMAIL","slack_SLACK_SEND_MESSAGE","gmail_GMAIL_FETCH_EMAILS","slack_SLACK_SENDS_A_MESSAGE_TO_A_SLACK_CHANNEL","slack_SLACK_SENDS_EPHEMERAL_MESSAGES_TO_CHANNEL_USERS"],"tools":[{"name":"gmail_GMAIL_SEND_EMAIL","description":"Sends an email via gmail api using the authenticated user's google profile display name, requiring `is html=true` if the body contains html and valid `s3key`, `mimetype`, `name` for any attachment. (part of the gmail toolkit — requires a connected gmail account)","risk":"write","toolkit":"gmail","connectRequired":true},{"name":"gmail_GMAIL_CREATE_EMAIL_DRAFT","description":"Creates a gmail email draft, supporting to/cc/bcc, subject, plain/html body (ensure `is html=true` for html), attachments, and threading. (part of the gmail toolkit — requires a connected gmail account)","risk":"write","toolkit":"gmail","connectRequired":true},{"name":"gmail_GMAIL_SEND_DRAFT","description":"Sends the specified, existing draft to the recipients in the to, cc, and bcc headers. (part of the gmail toolkit — requires a connected gmail account)","risk":"write","toolkit":"gmail","connectRequired":true},{"name":"slack_SLACK_FIND_USER_BY_EMAIL_ADDRESS","description":"Retrieves the slack user object for an active user by their registered email address; fails with 'users not found' if the email is unregistered or the user is inactive.","risk":"read","toolkit":"slack","connectRequired":true},{"name":"slack_SLACK_SEND_EPHEMERAL_MESSAGE","description":"Sends an ephemeral message to a user in a channel.","risk":"write","toolkit":"slack","connectRequired":true},{"name":"gmail_GMAIL_ADD_LABEL_TO_EMAIL","description":"Adds and/or removes specified gmail labels for a message; ensure `message id` and all `label ids` are valid (use 'listlabels' for custom label ids). (part of the gmail toolkit — requires a connected gmail account)","risk":"write","toolkit":"gmail","connectRequired":true},{"name":"slack_SLACK_SEND_MESSAGE","description":"Posts a message to a slack channel, direct message, or private group; requires content via `text`, `blocks`, or `attachments`.","risk":"write","toolkit":"slack","connectRequired":true},{"name":"gmail_GMAIL_FETCH_EMAILS","description":"Fetches a list of email messages from a gmail account, supporting filtering, pagination, and optional full content retrieval. (part of the gmail toolkit — requires a connected gmail account)","risk":"read","toolkit":"gmail","connectRequired":true},{"name":"slack_SLACK_SENDS_A_MESSAGE_TO_A_SLACK_CHANNEL","description":"Deprecated: posts a message to a slack channel, direct message, or private group. use `send message` instead.","risk":"write","toolkit":"slack","connectRequired":true},{"name":"slack_SLACK_SENDS_EPHEMERAL_MESSAGES_TO_CHANNEL_USERS","description":"Deprecated: sends an ephemeral message to a user in a channel. use `send ephemeral message` instead.","risk":"write","toolkit":"slack","connectRequired":true}]},"dynamic":true}

