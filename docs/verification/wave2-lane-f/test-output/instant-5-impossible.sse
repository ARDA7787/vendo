data: {"type":"text-start","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79"}

data: {"type":"text-delta","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79","delta":"That"}

data: {"type":"text-delta","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79","delta":"'s not something I'm able to do. Maple doesn't support international"}

data: {"type":"text-delta","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79","delta":" wire transfers, and there's no way to hide or suppress transactions from your statements —"}

data: {"type":"text-delta","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79","delta":" every movement of money is recorded and visible to you in full."}

data: {"type":"text-delta","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79","delta":"\n\nIf you have a legitimate transfer need I can help with, I'm happy to assist."}

data: {"type":"text-end","id":"txt_1_6efb692a-7e77-4cc3-bae5-a93919ff7f79"}

data: [DONE]

