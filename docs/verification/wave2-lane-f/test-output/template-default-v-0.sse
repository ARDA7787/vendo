data: {"type":"tool-input-available","toolCallId":"hcall_4_b78f63b0-f12e-4c78-97e6-f936f5d6d299","toolName":"vendo_apps_create","input":{"prompt":"Build a recent transactions view. Pull the live list of items from the host and display them as a clean, card-based transaction feed sorted by most recently updated first. For each transaction show: the item name as the transaction title, the amount formatted as currency (divide raw amount by 100 to get dollars), the status as a subtle badge (active = green, archived = muted/grey), and the updatedAt date formatted as a human-readable relative or short date. Include a summary row at the top showing total count and combined value of active transactions. Keep the layout comfortable density with smooth transitions."},"dynamic":true}

