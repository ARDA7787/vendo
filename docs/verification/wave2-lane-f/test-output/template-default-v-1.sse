data: {"type":"tool-input-available","toolCallId":"hcall_8_68f40c38-f5e5-463d-8d33-53e7a6fc2fb6","toolName":"vendo_apps_create","input":{"prompt":"Build a recent transactions view that lists all items from the host. For each transaction show: the name, the amount (formatted as currency), the status as a badge (active = green, archived = muted/grey), and the date from updatedAt formatted as a readable short date (e.g. \"Jul 23, 2026\"). Sort by most recent first. Display as a clean, comfortable-density list with subtle row dividers and a clear header that says \"Recent Transactions\". No charts, just the list."},"dynamic":true}

