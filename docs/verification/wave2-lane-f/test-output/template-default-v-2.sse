data: {"type":"tool-input-available","toolCallId":"hcall_12_3a7ad037-8834-4181-adaf-9a754c5c4419","toolName":"vendo_apps_create","input":{"prompt":"Create a recent transactions view. Fetch all items from the host and display them as a clean, scrollable list sorted by most recently updated. Each row should show: the item name, its status (active or archived) as a small badge, the amount formatted as currency (dollars), and the date it was last updated formatted as a readable short date. Use comfortable density and full motion for any transitions or hover states."},"dynamic":true}

