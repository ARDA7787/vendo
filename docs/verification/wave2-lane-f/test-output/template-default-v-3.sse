data: {"type":"tool-input-available","toolCallId":"hcall_16_4cd12756-5bca-4c26-be8e-443d358c485f","toolName":"vendo_apps_create","input":{"prompt":"Build a recent transactions view using the host's item list. Display each item as a transaction row showing the transaction name, amount (formatted as currency), status badge (active vs archived), and the date it was last updated. Sort by most recent first. The layout should feel like a clean financial transactions feed — comfortable density, clear hierarchy between name and metadata, with the amount prominently right-aligned on each row."},"dynamic":true}

