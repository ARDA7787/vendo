data: {"type":"tool-input-available","toolCallId":"hcall_21_891b7757-044d-4f2b-b1d7-657f34fecc2c","toolName":"vendo_apps_create","input":{"prompt":"Build a recent transactions view. Fetch the host items using the list items tool and display them as a clean activity feed sorted by most recently updated. Each row should show the item name, its status (active or archived) as a subtle badge, the amount formatted as currency, and the date it was last updated in a human-readable relative format (e.g. \"2 days ago\"). Active items should look normal; archived items should appear visually muted. Keep the layout comfortable and spacious."},"dynamic":true}

