data: {"type":"text-start","id":"txt_1_336498fa-d8bb-45d8-a38d-7e21f706fd85"}

data: {"type":"text-delta","id":"txt_1_336498fa-d8bb-45d8-a38d-7e21f706fd85","delta":"Let"}

data: {"type":"text-delta","id":"txt_1_336498fa-d8bb-45d8-a38d-7e21f706fd85","delta":" me check what items/data are available to work with first."}

data: {"type":"text-end","id":"txt_1_336498fa-d8bb-45d8-a38d-7e21f706fd85"}

